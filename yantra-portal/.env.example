# ═══════════════════════════════════════════════════════════════════════════
# Role Forge — environment variables
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (Neon Postgres on Vercel; SQLite ok for local) ───────────────
DATABASE_URL="file:./dev.db"
# Production (Neon):
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://roleforge-tau.vercel.app"
NEXTAUTH_SECRET="change-me-long-random-string"

# ── LLM (AI resumes) — pick provider in Admin → Settings → LLM provider ──
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=90000

# Claude / Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=8192
# ANTHROPIC_TIMEOUT_MS=120000

# Optional: force provider (overrides Admin UI selection)
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic

# AI_MATCH_MAX_PASSES=2
# CHAIN_BUDGET_MS=270000

# ── Resend email (REQUIRED for real vendor mail) ──────────────────────────
# Domain (same as Yantra): contact.srsoftllc.com — must be verified in Resend.
# Get key: https://resend.com/api-keys  (or copy RESEND_API_KEY from Yantra Vercel)
#
# Everything below is ready except the secret key:
# RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Role Forge <noreply@contact.srsoftllc.com>"
# Alias also accepted: RESEND_FROM_EMAIL=noreply@contact.srsoftllc.com
# EMAIL_REPLY_TO=ops@contact.srsoftllc.com
# EMAIL_CC=ops@contact.srsoftllc.com
# EMAIL_BCC_OPS=ops@contact.srsoftllc.com   # Yantra-compatible BCC
# Must be false for real delivery:
EMAIL_DRY_RUN=false

# ── Optional ──────────────────────────────────────────────────────────────
# ALLOW_DETERMINISTIC_FALLBACK=false
