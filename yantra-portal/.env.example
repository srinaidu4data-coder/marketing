DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# Optional real AI (OpenAI-compatible)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Resend (same env names as live Yantra / Vercel) ─────────────────────────
# Copy these from: Vercel → yantra-mvp project → Settings → Environment Variables
# or from Resend dashboard → API Keys + Domains.
#
# Without RESEND_API_KEY, chain "Send" is simulated (audit only).
RESEND_API_KEY=
# Display name + verified domain address (required for production delivery)
EMAIL_FROM="Role Forge <marketing@your-verified-domain.com>"
# Optional default reply-to (else employee email is used per send)
# EMAIL_REPLY_TO=ops@your-domain.com
# Optional always-CC
# EMAIL_CC=
# Set true to log sends without calling Resend (safe testing)
# EMAIL_DRY_RUN=true
