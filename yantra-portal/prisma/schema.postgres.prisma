// Production schema for Vercel + Postgres (Neon / Vercel Postgres).
// Used when DATABASE_URL starts with postgres.
// Generate: prisma generate --schema=prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Optional direct (non-pooler) URL for migrations on Neon
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  allocations  Allocation[]
  chains       Chain[]
  auditLogs    AuditLog[]
}

model Candidate {
  id                String             @id @default(uuid())
  name              String
  email             String
  masterResumeText  String             @default("") @db.Text
  masterResumePath  String?
  /// Structured ground truth from master — parse-on-upload
  masterProfileJson String             @default("{}") @db.Text
  layoutId          String             @default("ats_classic")
  exportFormat      String             @default("DOCX")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  allocations       Allocation[]
  chainCandidates   ChainCandidate[]
  vendorSubmissions VendorSubmission[]
}

model Allocation {
  id          String    @id @default(uuid())
  candidateId String
  employeeId  String
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employee    User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([candidateId, employeeId])
}

model Chain {
  id           String           @id @default(uuid())
  employeeId   String
  vendorName   String
  vendorEmail  String
  rawJobText   String           @db.Text
  status       String           @default("READY")
  employeeNote String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  employee     User             @relation(fields: [employeeId], references: [id])
  candidates   ChainCandidate[]
}

model ChainCandidate {
  id                 String    @id @default(uuid())
  chainId            String
  candidateId        String
  tailoredResumeText String    @default("") @db.Text
  tailoredResumePath String?
  docxPath           String?
  pdfPath            String?
  layoutId           String    @default("ats_classic")
  jobTitle           String    @default("")
  skillFingerprint   String    @default("")
  atsScore           Int       @default(0)
  atsReady           Boolean   @default(false)
  atsBreakdownJson   String    @default("{}") @db.Text
  sendStatus         String    @default("PENDING")
  createdAt          DateTime  @default(now())
  chain              Chain     @relation(fields: [chainId], references: [id], onDelete: Cascade)
  candidate          Candidate @relation(fields: [candidateId], references: [id])
}

model VendorSubmission {
  id               String    @id @default(uuid())
  candidateId      String
  vendorEmail      String
  vendorName       String
  jobTitle         String
  skillFingerprint String
  chainId          String?
  employeeId       String?
  sentAt           DateTime  @default(now())
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, vendorEmail])
}

model PromptVersion {
  id        String   @id @default(uuid())
  content   String   @db.Text
  status    String   @default("DRAFT")
  tested    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailTemplateVersion {
  id        String   @id @default(uuid())
  type      String
  content   String   @db.Text
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  meta      String   @default("{}") @db.Text
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ApiUsageLog {
  id           String   @id @default(uuid())
  employeeId   String?
  operation    String
  tokensIn     Int      @default(0)
  tokensOut    Int      @default(0)
  costUsd      Float    @default(0)
  isTestMode   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
